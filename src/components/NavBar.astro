---
import { content } from '../lib/content';

const { nav, brand } = content;
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="#top" class="nav-brand" aria-label={`${brand.wordmark} — back to top`}>
      <span class="mark">⟡ {brand.wordmark}</span>
      <span class="tag">{brand.tagline}</span>
    </a>

    <nav class="nav-links" aria-label={nav.ariaLabel}>
      {nav.links.map((link) => (
        <a class="nav-link" href={link.href}>{link.label}</a>
      ))}
      <button type="button" class="nav-link palette-btn" data-palette-open aria-label="Open Thread Finder quick navigation">
        find <kbd>⌘K</kbd>
      </button>
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false">
        <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <a class="btn btn-primary !px-4 !py-2 !text-[0.74rem]" href={nav.cta.href}>{nav.cta.label}</a>
    </nav>

    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-label="Toggle navigation menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="wrap nav-mobile">
    {nav.links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <button type="button" class="palette-btn self-start py-2 font-mono text-sm text-ink-dim" data-palette-open>
      find anything <kbd>⌘K</kbd>
    </button>
    <button type="button" class="self-start py-2 font-mono text-sm text-ink-dim" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false">
      toggle theme
    </button>
    <a href={nav.cta.href} class="!text-emerald">{nav.cta.label} →</a>
  </div>
</header>
