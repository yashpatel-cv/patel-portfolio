---
import '../styles/global.css';
import ThreadFinder from '../components/ThreadFinder.astro';
import { content } from '../lib/content';

const { meta, contact, projects } = content;

const linkedin = contact.channels.find((channel) => channel.label === 'LinkedIn')?.href;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';

/**
 * JSON-LD graph: ProfilePage → Person + ItemList of the three case-study
 * nodes. All values flow from content.json — schema stays in lockstep
 * with the visible page.
 */
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': canonical ?? '#profile',
      mainEntity: { '@id': '#yash' },
    },
    {
      '@type': 'Person',
      '@id': '#yash',
      name: meta.author,
      jobTitle: 'Full-Stack Developer — AI Orchestration & Automation',
      email: `mailto:${contact.email}`,
      address: { '@type': 'PostalAddress', addressLocality: 'Kitchener', addressRegion: 'ON', addressCountry: 'CA' },
      sameAs: linkedin ? [linkedin] : [],
      knowsAbout: meta.keywords,
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        name: 'Hugging Face AI Agents Course — Certificate of Fundamentals of Agents',
      },
    },
    {
      '@type': 'ItemList',
      name: 'Case Studies',
      itemListElement: projects.items.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'CreativeWork',
          name: `${project.codename} — ${project.name}`,
          description: project.summary,
          creativeWorkStatus: project.status.label,
          author: { '@id': '#yash' },
          keywords: project.stack.join(', '),
        },
      })),
    },
  ],
});
---

<!doctype html>
<html lang={meta.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set theme before paint to avoid a flash. Light is the default. */}
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content={meta.author} />
    <meta name="keywords" content={meta.keywords.join(', ')} />
    <meta name="theme-color" content={meta.themeColor} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${meta.author} — portfolio orchestration canvas`} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={schema} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-emerald focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-void"
    >
      Skip to content
    </a>
    <slot />
    <ThreadFinder />
    <script>
      import '../scripts/threads';
      import '../scripts/palette';
      import '../scripts/theme';
    </script>
  </body>
</html>
