# Normalize line endings to LF in the repo regardless of OS/editor config.
# Dev happens on Windows, deploy target is Linux ARM64 — without this,
# Windows git (core.autocrlf=true) flags re-saved files as modified even
# when content is unchanged.
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
